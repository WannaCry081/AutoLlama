# Copy to .env and tweak. All vars are optional — defaults match a local Ollama install.

OLLAMA_URL=http://localhost:11434
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Bucket -> Ollama model tag. Parsed as JSON; must be a single line.
# Keys (buckets) are referenced by the router; values are the concrete `ollama pull` tags.
MODELS={"general":"qwen3:30b-a3b","coder":"qwen2.5-coder:32b","fast":"qwen2.5:7b","reasoner":"deepseek-r1:14b"}

# Which bucket's model handles classification of ambiguous prompts. Must be a key in MODELS.
CLASSIFIER_BUCKET=fast
